<?xml version="1.0" encoding="UTF-8"?>

<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="TarugViewStructureView" parent="GtkBox">
    <property name="orientation">1</property>
    <property name="spacing">4</property>
    <property name="margin-top">22</property>
    <child>
      <object class="GtkGrid">
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <property name="row-homogeneous">true</property>
        <property name="column-homogeneous">true</property>
        <property name="row-spacing">24</property>
        <child>
          <object class="TarugTableColumnInfo" id="columns">
            <property name="columns" bind-source="TarugViewStructureView" bind-property="columns" bind-flags="sync-create"/>
            <layout>
              <property name="row">0</property>
              <property name="column">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="vexpand">true</property>
            <property name="spacing">8</property>
            <property name="orientation">1</property>
            <child>
              <object class="GtkBox">
                <property name="halign">0</property>
                <child>
                  <object class="GtkLabel">
                    <style>
                      <class name="heading"/>
                    </style>
                    <property name="margin-start">8</property>
                    <property name="label">View definition</property>
                    <property name="halign">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="icon-name">copy-symbolic</property>
                    <property name="halign">2</property>
                    <property name="tooltip-text">Copy View Defs</property>
                    <property name="margin-end">8</property>
                    <signal name="clicked" handler="on_copy_clicked"/>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkSourceView" id="editor">
                    <property name="buffer">
                      <object class="GtkSourceBuffer" id="buffer"></object>
                    </property>
                    <property name="wrap-mode">2</property>
                    <property name="editable">false</property>
                    <property name="monospace">true</property>
                    <property name="auto-indent">true</property>
                    <property name="smart-backspace">true</property>
                    <property name="smart-home-end">1</property>
                    <property name="top-margin">6</property>
                    <property name="vexpand">true</property>
                  </object>
                </child>
              </object>
            </child>
            <layout>
              <property name="row">2</property>
              <property name="column">1</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>