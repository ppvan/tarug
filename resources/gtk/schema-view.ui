<?xml version="1.0" encoding="UTF-8"?>

<interface>
  <requires lib="gtk" version="4.0"/>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="custom">style-switcher</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_New Window</attribute>
        <attribute name="action">app.new-window</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <template class="TarugSchemaView" parent="AdwBin">
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">1</property>
        <child>
          <object class="GtkPaned" id="paned">
            <property name="shrink-end-child">false</property>
            <property name="shrink-start-child">false</property>
            <child type="start">
              <object class="GtkBox" id="sidebar">
                <property name="orientation">1</property>
                <property name="width-request">300</property>
                <property name="spacing">3</property>
                <child>
                  <object class="GtkBox">
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <property name="hexpand">true</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkLabel">
                        <style>
                          <class name="heading"/>
                        </style>
                        <property name="halign">1</property>
                        <property name="margin-bottom">0</property>
                        <property name="label">Schema</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="dropdown">
                        <property name="hexpand">true</property>
                        <binding name="model">
                          <lookup name="schemas" type="TarugSchemaViewModel">
                            <lookup name="schema-viewmodel" type="TarugSchemaView">
                              <constant>TarugSchemaView</constant>
                            </lookup>
                          </lookup>
                        </binding>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwViewSwitcher" id="tables_views_switcher">
                    <style>
                      <class name="big-icon"/>
                    </style>
                    <property name="height-request">40</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">4</property>
                    <property name="margin-bottom">12</property>
                    <property name="policy">1</property>
                    <property name="stack">sql_views</property>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator"></object>
                </child>
                <child>
                  <object class="AdwViewStack" id="sql_views">
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="icon-name">table-symbolic</property>
                        <property name="name">table</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-start">8</property>
                                <property name="margin-end">8</property>
                                <property name="margin-top">4</property>
                                <property name="margin-bottom">8</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="heading"/>
                                    </style>
                                    <property name="margin-top">8</property>
                                    <property name="margin-start">4</property>
                                    <property name="halign">1</property>
                                    <property name="margin-bottom">0</property>
                                    <property name="label">Tables</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="badges"/>
                                    </style>
                                    <property name="margin-top">8</property>
                                    <property name="margin-start">4</property>
                                    <property name="halign">3</property>
                                    <property name="valign">3</property>
                                    <property name="margin-bottom">0</property>
                                    <property name="label" bind-source="table_model" bind-property="n-items" bind-flags="sync-create"/>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSeparator">
                                    <property name="hexpand">true</property>
                                    <style>
                                      <class name="spacer"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkToggleButton" id="search_btn">
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <property name="tooltip-text">Search tables</property>
                                    <property name="icon-name">loupe-large-symbolic</property>
                                    <signal name="toggled" handler="table_search_reveal"/>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkRevealer">
                                <property name="transition-duration">300</property>
                                <property name="reveal-child" bind-source="search_btn" bind-property="active" bind-flags="sync-create"/>
                                <style>
                                  <class name="background"/>
                                </style>
                                <child>
                                  <object class="GtkSearchEntry" id="search_table_entry">
                                    <property name="placeholder-text">Search Tables</property>
                                    <property name="margin-start">6</property>
                                    <property name="margin-end">6</property>
                                    <property name="margin-top">4</property>
                                    <property name="margin-bottom">4</property>
                                    <signal name="search-changed" handler="on_table_search"/>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="vexpand">true</property>
                                <child>
                                  <object class="GtkListView" id="table_list">
                                    <style>
                                      <class name="navigation-sidebar"/>
                                    </style>
                                    <property name="model">
                                      <object class="GtkSingleSelection" id="table_selection">
                                        <property name="model">
                                          <object class="GtkSortListModel" id="table_sort_model">
                                            <property name="model">
                                              <object class="GtkFilterListModel" id="table_model">
                                                <property name="incremental">true</property>
                                                <binding name="model">
                                                  <lookup name="tables" type="TarugTableViewModel">
                                                    <lookup name="table-viewmodel" type="TarugSchemaView">
                                                      <constant>TarugSchemaView</constant>
                                                    </lookup>
                                                  </lookup>
                                                </binding>
                                                <property name="filter">
                                                  <object class="GtkStringFilter" id="table_filter"></object>
                                                </property>
                                              </object>
                                            </property>
                                          </object>
                                        </property>
                                        <property name="autoselect">true</property>
                                      </object>
                                    </property>
                                    <signal name="activate" handler="on_tablelist_activate"/>
                                    <property name="factory">
                                      <object class="GtkBuilderListItemFactory">
                                        <property name="resource">/io/github/ppvan/tarug/gtk/table-listitem.ui</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="icon-name">category-search-symbolic</property>
                        <property name="name">view</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-start">8</property>
                                <property name="margin-end">8</property>
                                <property name="margin-top">4</property>
                                <property name="margin-bottom">8</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="heading"/>
                                    </style>
                                    <property name="margin-top">8</property>
                                    <property name="margin-start">4</property>
                                    <property name="halign">1</property>
                                    <property name="margin-bottom">0</property>
                                    <property name="label">Views</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="badges"/>
                                    </style>
                                    <property name="margin-top">8</property>
                                    <property name="margin-start">4</property>
                                    <property name="halign">3</property>
                                    <property name="valign">3</property>
                                    <property name="margin-bottom">0</property>
                                    <property name="label" bind-source="view_model" bind-property="n-items" bind-flags="sync-create"/>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSeparator">
                                    <property name="hexpand">true</property>
                                    <style>
                                      <class name="spacer"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkToggleButton" id="search_views_btn">
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <property name="tooltip-text">Search views</property>
                                    <property name="icon-name">loupe-large-symbolic</property>
                                    <signal name="toggled" handler="view_search_reveal"/>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkRevealer">
                                <property name="transition-duration">300</property>
                                <property name="reveal-child" bind-source="search_views_btn" bind-property="active" bind-flags="sync-create"/>
                                <style>
                                  <class name="background"/>
                                </style>
                                <child>
                                  <object class="GtkSearchEntry" id="search_views_entry">
                                    <property name="placeholder-text">Search Views</property>
                                    <property name="margin-start">4</property>
                                    <property name="margin-bottom">4</property>
                                    <signal name="search-changed" handler="on_view_search"/>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="vexpand">true</property>
                                <child>
                                  <object class="GtkListView" id="views_list">
                                    <style>
                                      <class name="navigation-sidebar"/>
                                    </style>
                                    <property name="model">
                                      <object class="GtkSingleSelection" id="view_selection">
                                        <property name="model">
                                          <object class="GtkSortListModel" id="view_sort_model">
                                            <property name="model">
                                              <object class="GtkFilterListModel" id="view_model">
                                                <property name="incremental">true</property>
                                                <binding name="model">
                                                  <lookup name="views" type="TarugViewViewModel">
                                                    <lookup name="view-viewmodel" type="TarugSchemaView">
                                                      <constant>TarugSchemaView</constant>
                                                    </lookup>
                                                  </lookup>
                                                </binding>
                                                <property name="filter">
                                                  <object class="GtkStringFilter" id="view_filter"></object>
                                                </property>
                                              </object>
                                            </property>
                                          </object>
                                        </property>
                                        <property name="autoselect">true</property>
                                      </object>
                                    </property>
                                    <property name="factory">
                                      <object class="GtkBuilderListItemFactory">
                                        <property name="resource">/io/github/ppvan/tarug/gtk/view-listitem.ui</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">4</property>
                    <property name="margin-bottom">8</property>
                    <property name="margin-end">2</property>
                    <property name="margin-start">4</property>
                    <child>
                      <object class="GtkButton">
                        <property name="visible">false</property>
                        <style>
                          <class name="flat"/>
                        </style>
                        <property name="icon-name">plus-large-symbolic</property>
                        <property name="tooltip-text">Create new table</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="reload">
                        <style>
                          <class name="flat"/>
                        </style>
                        <property name="icon-name">refresh-large-symbolic</property>
                        <property name="tooltip-text">Reload tables</property>
                        <signal name="clicked" handler="reload_btn_clicked"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="logout">
                        <style>
                          <class name="flat"/>
                        </style>
                        <property name="icon-name">step-out-symbolic</property>
                        <property name="tooltip-text">Logout</property>
                        <signal name="clicked" handler="logout_btn_clicked"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="end">
              <object class="GtkBox" id="main-view">
                <property name="orientation">1</property>
                <property name="width-request">920</property>
                <child>
                  <object class="AdwHeaderBar">
                    <style>
                      <class name="flat"/>
                    </style>
                    <child type="title">
                      <object class="AdwViewSwitcher">
                        <property name="policy">1</property>
                        <property name="stack">stack</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="menu-model">primary_menu</property>
                        <property name="popover">
                          <object class="GtkPopoverMenu">
                            <property name="menu-model">primary_menu</property>
                            <child type="style-switcher">
                              <object class="TarugStyleSwitcher"></object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStack" id="stack">
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="name">structure-view</property>
                        <property name="icon-name">library-symbolic</property>
                        <property name="title">Structure</property>
                        <property name="child">
                          <object class="GtkStack">
                            <property name="visible-child-name" bind-source="TarugSchemaView" bind-property="view-mode" bind-flags="sync-create"/>
                            <property name="transition-type">6</property>
                            <property name="margin-top">10</property>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">table</property>
                                <property name="child">
                                  <object class="TarugTableStructureView"></object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">view</property>
                                <property name="child">
                                  <object class="TarugViewStructureView"></object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="name">data-view</property>
                        <property name="title">Data</property>
                        <property name="icon-name">object-rows-symbolic</property>
                        <property name="child">
                          <object class="GtkStack">
                            <property name="visible-child-name" bind-source="TarugSchemaView" bind-property="view-mode" bind-flags="sync-create"/>
                            <property name="transition-type">6</property>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">table</property>
                                <property name="child">
                                  <object class="TarugTableDataView"></object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">view</property>
                                <property name="child">
                                  <object class="TarugViewDataView"></object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="name">query-editor</property>
                        <property name="icon-name">terminal-symbolic</property>
                        <property name="title">Query</property>
                        <property name="child">
                          <object class="TarugQueryEditor"></object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>