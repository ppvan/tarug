<?xml version="1.0" encoding="UTF-8"?>

<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="TarugRestoreDialog" parent="AdwDialog">
    <property name="follows-content-size">true</property>
    <property name="title" translatable="yes">Restore database</property>
    <property name="presentation-mode">1</property>
    <style>
      <class name="backup-dialog"/>
    </style>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"></object>
        </child>
        <property name="content">
          <object class="AdwClamp">
            <property name="maximum-size">540</property>
            <property name="margin-top">16</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">1</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">1</property>
                    <property name="spacing">16</property>
                    <child>
                      <object class="GtkListBox">
                        <style>
                          <class name="boxed-list"/>
                        </style>
                        <property name="selection-mode">0</property>
                        <child>
                          <object class="AdwComboRow" id="database_row">
                            <property name="title" translatable="yes">Database</property>
                            <property name="subtitle" translatable="yes">Database to restore</property>
                            <binding name="model">
                              <lookup name="connections" type="TarugConnectionViewModel">
                                <lookup name="viewmodel" type="TarugRestoreDialog">
                                  <constant>TarugRestoreDialog</constant>
                                </lookup>
                              </lookup>
                            </binding>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="format_row">
                            <property name="title" translatable="yes">Format</property>
                            <property name="subtitle" translatable="yes">Input file format</property>
                            <property name="model" bind-source="TarugRestoreDialog" bind-property="formats" bind-flags="sync-create"/>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="section_row">
                            <property name="title" translatable="yes">Restore section</property>
                            <property name="subtitle" translatable="yes">Restore schema-only, data-only or both</property>
                            <property name="model" bind-source="TarugRestoreDialog" bind-property="sections" bind-flags="sync-create"/>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow">
                            <property name="title" translatable="yes">Override old schema</property>
                            <property name="subtitle" translatable="yes">DROP old tables before restore</property>
                            <property name="active" bind-source="TarugRestoreDialog" bind-property="clean" bind-flags="sync-create|bidirectional"/>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow">
                            <property name="title" translatable="yes">Create database</property>
                            <property name="subtitle" translatable="yes">Add CREATE DATABASE before restore</property>
                            <property name="active" bind-source="TarugRestoreDialog" bind-property="create" bind-flags="sync-create|bidirectional"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="run_button">
                        <style>
                          <class name="suggested-action"/>
                        </style>
                        <property name="halign">2</property>
                        <property name="margin-bottom">20</property>
                        <property name="label" translatable="yes">Restore</property>
                        <property name="valign">2</property>
                        <property name="use-underline">true</property>
                        <signal name="clicked" handler="on_do_restore_click"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>