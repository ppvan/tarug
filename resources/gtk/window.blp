using Gtk 4.0;
using Adw 1;

template $TarugWindow: Adw.ApplicationWindow {
  title: "tarug";

  Adw.ToastOverlay overlay {
    Stack stack {
      transition-type: slide_up_down;
      visible-child-name: bind template.navigation as <$TarugNavigationService>.current-view;

      StackPage {
        name: "connection-view";

        child: $TarugConnectionView {};
      }

      StackPage query-view {
        name: "query-view";

        child: $TarugSchemaView {};
      }
    }
  }
}
